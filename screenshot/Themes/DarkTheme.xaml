<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark counterpart of LightTheme.xaml — same key set, Apple-style dark palette
  with the tangerine accent lifted for dark surfaces.
  Loaded by ThemeManager when the system runs dark.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:screenshot">

    <!-- ═══ Colors ═══ -->
    <Color x:Key="WindowBgColor">#FF1C1C1E</Color>
    <Color x:Key="CardBgColor">#FF2C2C2E</Color>
    <Color x:Key="CardBorderColor">#FF3F3F42</Color>
    <Color x:Key="ControlBgColor">#FF3A3A3C</Color>
    <Color x:Key="ControlBgHoverColor">#FF48484A</Color>
    <Color x:Key="ControlBorderColor">#FF4A4A4E</Color>
    <Color x:Key="DividerColor">#FF3A3A3E</Color>

    <Color x:Key="TextPrimaryColor">#FFF5F5F7</Color>
    <Color x:Key="TextSecondaryColor">#FF98989D</Color>
    <Color x:Key="TextTertiaryColor">#FF8E8E93</Color>
    <Color x:Key="TextFaintColor">#FF636366</Color>

    <!-- Tangerine accent, lifted for dark surfaces: #FB923C base, pale peel on hover -->
    <Color x:Key="AccentColor">#FFFB923C</Color>
    <Color x:Key="AccentSoftColor">#FF43290F</Color>
    <Color x:Key="AccentPressedColor">#FF573412</Color>

    <Color x:Key="SuccessColor">#FF30D158</Color>
    <Color x:Key="SuccessSoftColor">#FF17351F</Color>

    <Color x:Key="DangerColor">#FFFF453A</Color>
    <Color x:Key="DangerSoftColor">#FF3D1B1C</Color>

    <Color x:Key="KeyCapBgColor">#FF3A3A3C</Color>
    <Color x:Key="KeyCapBorderColor">#FF4A4A4E</Color>
    <Color x:Key="KeyCapTextColor">#FF98989D</Color>

    <!-- Translucent brushes -->
    <Color x:Key="MaskColor">#FF000000</Color>
    <Color x:Key="HoverShadeColor">#FF000000</Color>

    <!-- Floating pills / chips / viewer -->
    <Color x:Key="PillBgColor">#E62C2C2E</Color>
    <Color x:Key="SizeChipBgColor">#F22C2C2E</Color>
    <Color x:Key="ViewerBgColor">#FF0B0B0D</Color>

    <!-- Action buttons -->
    <Color x:Key="ActionButtonBgColor">#FF38383A</Color>
    <Color x:Key="AccentHoverBorderColor">#FF7A3F14</Color>
    <Color x:Key="SuccessHoverBorderColor">#FF1F4D2E</Color>
    <Color x:Key="DangerHoverBorderColor">#FF5C2426</Color>

    <!-- ═══ Brushes ═══ -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="ControlBgBrush" Color="{StaticResource ControlBgColor}" />
    <SolidColorBrush x:Key="ControlBgHoverBrush" Color="{StaticResource ControlBgHoverColor}" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />

    <SolidColorBrush x:Key="KeyCapBgBrush" Color="{StaticResource KeyCapBgColor}" />
    <SolidColorBrush x:Key="KeyCapBorderBrush" Color="{StaticResource KeyCapBorderColor}" />
    <SolidColorBrush x:Key="KeyCapTextBrush" Color="{StaticResource KeyCapTextColor}" />

    <SolidColorBrush x:Key="PillBgBrush" Color="{StaticResource PillBgColor}" />
    <SolidColorBrush x:Key="SizeChipBgBrush" Color="{StaticResource SizeChipBgColor}" />
    <SolidColorBrush x:Key="ViewerBgBrush" Color="{StaticResource ViewerBgColor}" />
    <SolidColorBrush x:Key="ActionButtonBgBrush" Color="{StaticResource ActionButtonBgColor}" />
    <SolidColorBrush x:Key="AccentHoverBorderBrush" Color="{StaticResource AccentHoverBorderColor}" />
    <SolidColorBrush x:Key="SuccessHoverBorderBrush" Color="{StaticResource SuccessHoverBorderColor}" />
    <SolidColorBrush x:Key="DangerHoverBorderBrush" Color="{StaticResource DangerHoverBorderColor}" />

    <!-- Screen dim mask (region selector), soft black -->
    <SolidColorBrush x:Key="MaskBrush" Color="{StaticResource MaskColor}" Opacity="0.45" />
    <!-- Preview hover shade -->
    <SolidColorBrush x:Key="HoverShadeBrush" Color="{StaticResource HoverShadeColor}" Opacity="0.5" />

    <!-- ═══ Keyboard key cap ═══ -->
    <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource KeyCapBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KeyCapBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style x:Key="KeyCapText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource KeyCapTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ═══ Preview action button: rounded square, hover tint via ButtonAssist ═══ -->
    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Background" Value="{DynamicResource ActionButtonBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{Binding Path=(local:ButtonAssist.HoverBrush), RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="bd" Property="BorderBrush"
                                    Value="{Binding Path=(local:ButtonAssist.HoverBorderBrush), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
