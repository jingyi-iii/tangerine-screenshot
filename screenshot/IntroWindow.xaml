<Window x:Class="screenshot.IntroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Opacity="0"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!-- One-time hello: the only shortcut worth memorizing. Then it never appears again. -->
    <Border Background="{DynamicResource PillBgBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="24,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Direction="270"
                              Opacity="0.16" Color="#1D1D1F" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Press"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Border Style="{DynamicResource KeyCap}">
                <TextBlock Style="{DynamicResource KeyCapText}" Text="Ctrl" />
            </Border>
            <TextBlock Text="+" Foreground="{DynamicResource TextFaintBrush}"
                       FontSize="11" VerticalAlignment="Center" Margin="6,0" />
            <Border Style="{DynamicResource KeyCap}">
                <TextBlock Style="{DynamicResource KeyCapText}" Text="Shift" />
            </Border>
            <TextBlock Text="+" Foreground="{DynamicResource TextFaintBrush}"
                       FontSize="11" VerticalAlignment="Center" Margin="6,0" />
            <Border Style="{DynamicResource KeyCap}" MinWidth="26">
                <TextBlock Style="{DynamicResource KeyCapText}" Text="S" />
            </Border>
            <TextBlock Text="— to screenshot anything, anytime."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0" />
        </StackPanel>
    </Border>
</Window>
