<Window x:Class="screenshot.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        Cursor="Cross"
        Focusable="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        KeyDown="OnKeyDown"
        MouseLeftButtonDown="OnMouseDown"
        MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnMouseUp">

    <!-- Nearly-transparent backdrop so the layered window is hit-testable -->
    <Canvas x:Name="Root" Background="#01FFFFFF">

        <!-- Dim mask: 4 rectangles around the hole -->
        <Rectangle x:Name="MaskLeft"   Fill="{DynamicResource MaskBrush}" />
        <Rectangle x:Name="MaskRight"  Fill="{DynamicResource MaskBrush}" />
        <Rectangle x:Name="MaskTop"    Fill="{DynamicResource MaskBrush}" />
        <Rectangle x:Name="MaskBottom" Fill="{DynamicResource MaskBrush}" />

        <!-- Hint pill (first run only; fades away once the user engages) -->
        <Border x:Name="HintPill"
                Canvas.ZIndex="5"
                Background="{DynamicResource PillBgBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18,9">
            <TextBlock Text="Click a window to grab it  ·  Drag to select  ·  Esc to cancel"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="13" FontWeight="Medium" />
        </Border>

        <!-- Selection border -->
        <Border x:Name="SelectionBox"
                Canvas.ZIndex="3"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1.5"
                Background="Transparent"
                Visibility="Collapsed" />

        <!-- Size label, hugging the selection's bottom-right corner from outside -->
        <Border x:Name="SizeChip"
                Canvas.ZIndex="4"
                Background="{DynamicResource SizeChipBgBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,4"
                Visibility="Collapsed">
            <TextBlock x:Name="SizeText"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="12" FontWeight="SemiBold" />
        </Border>

        <!-- Pixel loupe: 13 physical pixels across, nearest-neighbor ×10 -->
        <Border x:Name="Loupe"
                Canvas.ZIndex="6"
                Width="132" Height="132"
                CornerRadius="66"
                Background="#CC000000"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Grid x:Name="LoupeHost">
                <Image x:Name="LoupeImg"
                       Width="130" Height="130"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <!-- The exact pixel under the cursor -->
                <Rectangle Width="10" Height="10"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stroke="{DynamicResource AccentBrush}"
                           StrokeThickness="1" />
            </Grid>
        </Border>
    </Canvas>
</Window>
