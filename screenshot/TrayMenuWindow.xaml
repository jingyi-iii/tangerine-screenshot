<Window x:Class="screenshot.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:screenshot"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">

    <!--
      The tray menu. It is a real window rather than a WinForms ContextMenuStrip
      because the strip can only draw its own chrome: square corners, a system
      colour table, and no idea that this app has a dark theme. Everything here
      comes from the same theme brushes as the rest of the app, so it follows
      WindowIcon and the light/dark swap like every other surface.
    -->
    <Grid x:Name="Root" Margin="18" Opacity="0">
        <Grid.Resources>
            <!--
              Rows are Buttons so hover, press and keyboard focus all come for free,
              and so the menu is reachable with a screen reader. The hover tint is a
              ButtonAssist attached property, exactly as the preview card's action
              buttons do it, which lets the destructive row tint red without a
              second copy of the template.
            -->
            <Style x:Key="MenuRow" TargetType="Button">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="local:ButtonAssist.HoverBrush" Value="{DynamicResource ControlBgHoverBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Focus lights up like hover: a dotted focus rectangle
                                     inside a menu reads as a rendering bug. -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background"
                                            Value="{Binding Path=(local:ButtonAssist.HoverBrush), RelativeSource={RelativeSource TemplatedParent}}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bd" Property="Background"
                                            Value="{Binding Path=(local:ButtonAssist.HoverBrush), RelativeSource={RelativeSource TemplatedParent}}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlBgBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MenuRowText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <!-- Keeps the label off the shortcut keys without widening every row. -->
                <Setter Property="Margin" Value="0,0,10,0" />
            </Style>

            <Style x:Key="MenuRowTextDanger" TargetType="TextBlock" BasedOn="{StaticResource MenuRowText}">
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </Style>

            <!-- 24x24 icon canvas scaled to 16: same geometry convention as the
                 preview card's action buttons (stroke 2, round caps and joins). -->
            <Style x:Key="MenuIcon" TargetType="Viewbox">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="MenuSeparator" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="9,4" />
                <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>
        </Grid.Resources>

        <Grid.RenderTransform>
            <TranslateTransform x:Name="AppearSlide" Y="8" />
        </Grid.RenderTransform>

        <!-- Shadow carrier. Kept as its own element because an Effect forces the
             subtree it is attached to through an offscreen bitmap; hanging it on
             the surface itself would cost the text its ClearType. -->
        <Border CornerRadius="7" Background="{DynamicResource CardBgBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Direction="270"
                                  Opacity="0.18" Color="#1D1D1F" />
            </Border.Effect>
        </Border>

        <Border x:Name="Shell"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="7"
                MinWidth="236"
                RenderOptions.ClearTypeHint="Enabled">
            <StackPanel Margin="6">

                <!-- Capture: the two things the app is for -->
                <Button x:Name="RegionRow" Style="{StaticResource MenuRow}"
                        AutomationProperties.Name="Region or window screenshot"
                        Click="OnRegionClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Style="{StaticResource MenuIcon}">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M6.5 2 V15.5 A2 2 0 0 0 8.5 17.5 H22 M2 6.5 H15.5 A2 2 0 0 1 17.5 8.5 V22" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="1" Style="{StaticResource MenuRowText}"
                                   Text="Region / Window Screenshot" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{DynamicResource KeyCap}" Margin="4,0,0,0">
                                <TextBlock Style="{DynamicResource KeyCapText}" Text="Ctrl" />
                            </Border>
                            <Border Style="{DynamicResource KeyCap}" Margin="4,0,0,0">
                                <TextBlock Style="{DynamicResource KeyCapText}" Text="Shift" />
                            </Border>
                            <Border Style="{DynamicResource KeyCap}" Margin="4,0,0,0">
                                <TextBlock Style="{DynamicResource KeyCapText}" Text="S" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Name="FullRow" Style="{StaticResource MenuRow}"
                        AutomationProperties.Name="Full screen screenshot"
                        Click="OnFullScreenClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Style="{StaticResource MenuIcon}">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M4 9 V4 H9 M15 4 H20 V9 M20 15 V20 H15 M9 20 H4 V15" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="1" Style="{StaticResource MenuRowText}" Text="Full Screen" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{DynamicResource KeyCap}" Margin="4,0,0,0">
                                <TextBlock Style="{DynamicResource KeyCapText}" Text="Ctrl" />
                            </Border>
                            <Border Style="{DynamicResource KeyCap}" Margin="4,0,0,0">
                                <TextBlock Style="{DynamicResource KeyCapText}" Text="Shift" />
                            </Border>
                            <Border Style="{DynamicResource KeyCap}" Margin="4,0,0,0">
                                <TextBlock Style="{DynamicResource KeyCapText}" Text="F" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Button>

                <Border x:Name="SepCapture" Style="{StaticResource MenuSeparator}" />

                <!-- Only present while the global hotkeys are dead: the one place a
                     user who lost their shortcut would come looking. -->
                <Button x:Name="WarnRow" Style="{StaticResource MenuRow}"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Hotkeys unavailable, retry registration"
                        local:ButtonAssist.HoverBrush="{DynamicResource DangerSoftBrush}"
                        Click="OnRetryClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Style="{StaticResource MenuIcon}">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{DynamicResource DangerBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M12 3 L22 20.5 H2 Z M12 9.5 V14" />
                                <Ellipse Canvas.Left="10.9" Canvas.Top="15.9"
                                         Width="2.2" Height="2.2"
                                         Fill="{DynamicResource DangerBrush}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="1" Style="{StaticResource MenuRowTextDanger}"
                                   Text="Hotkeys unavailable — click to retry" />
                    </Grid>
                </Button>

                <Border x:Name="SepWarning" Style="{StaticResource MenuSeparator}" Visibility="Collapsed" />

                <Button x:Name="ExitRow" Style="{StaticResource MenuRow}"
                        AutomationProperties.Name="Exit screenshot"
                        local:ButtonAssist.HoverBrush="{DynamicResource DangerSoftBrush}"
                        Click="OnExitClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Style="{StaticResource MenuIcon}">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{DynamicResource DangerBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M11 3.5 H5.5 A2 2 0 0 0 3.5 5.5 V18.5 A2 2 0 0 0 5.5 20.5 H11 M10 12 H20.5 M16.5 8 L20.5 12 L16.5 16" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="1" Style="{StaticResource MenuRowText}" Text="Exit" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
