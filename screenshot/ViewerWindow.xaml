<Window x:Class="screenshot.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="True"
        Background="{DynamicResource ViewerBgBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        MouseLeftButtonDown="OnClose"
        MouseMove="OnMouseMove"
        KeyDown="OnKeyDown">

    <Grid>
        <Image x:Name="Img"
               Margin="50,50,50,110"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <Border x:Name="HintPill"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,36"
                Background="{DynamicResource PillBgBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="14,7">
            <TextBlock Text="Click anywhere or press Esc to close"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       FontSize="12" />
        </Border>
    </Grid>
</Window>
